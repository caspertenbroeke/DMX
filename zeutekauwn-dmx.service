[Unit]
Description=Zeutekauwn DMXDesk (telefoon + instellingen op poort 8080)
After=network-online.target
Wants=network-online.target

[Service]
User=casper
Group=casper
SupplementaryGroups=dialout
WorkingDirectory=/home/casper/dmxdesk
ExecStart=/usr/bin/python3 -u /home/casper/dmxdesk/dmxdesk.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
